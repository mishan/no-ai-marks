#!/usr/bin/env python3
"""Run no-ai-marks from a checkout without installing it."""

import os
import sys

if sys.version_info < (3, 11):
    sys.exit("no-ai-marks needs Python 3.11 or newer")

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from no_ai_marks.__main__ import main  # noqa: E402

sys.exit(main())
